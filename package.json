{
	"name": "@carekind/shared",
	"version": "0.1.0",
	"private": true,
	"description": "careKind shared contract layer: zod schemas, API contracts, typed API client, formatting helpers and design system styles.",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./schemas": "./src/schemas/index.ts",
		"./contracts": "./src/contracts/index.ts",
		"./api-client": "./src/api-client/index.ts",
		"./format": "./src/format/index.ts",
		"./policy": "./src/policy/index.ts",
		"./ui": "./src/ui/index.ts",
		"./styles/*.css": "./src/styles/*.css",
		"./brand/*.svg": "./src/brand/*.svg",
		"./brand/*.png": "./src/brand/*.png"
	},
	"files": [
		"src"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint src",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.13.0",
		"jsdom": "^27.4.0",
		"prettier": "^3.9.10",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.12"
	}
}
